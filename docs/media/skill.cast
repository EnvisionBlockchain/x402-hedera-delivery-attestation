[10.303827, "o", "  \u001b[38;2;126;224;195m✓\u001b[39m  \u001b[38;2;126;224;195mpayment_id_matches_signed   \u001b[39m\u001b[38;2;182;190;201mrelayed transaction id matches the one the buyer signed\r\n                                 (0.0.7162784@1785518278.228661878)\u001b[39m\r\n  \u001b[38;2;126;224;195m✓\u001b[39m  \u001b[38;2;126;224;195mpayment_confirmed_on_chain  \u001b[39m\u001b[38;2;182;190;201mpayment confirmed on chain with result SUCCESS at consensus 1785518288.182486195\u001b[39m\r\n  \u001b[38;2;126;224;195m✓\u001b[39m  \u001b[38;2;126;224;195mpayment_credited_the_seller \u001b[39m\u001b[38;2;182;190;201mthe ledger's transfer list credits 0.0.9857218 with 0.01 HBAR, the price that was\r\n                                 advertised\u001b[39m\r\n  \u001b[38;2;126;224;195m✓\u001b[39m  \u001b[38;2;126;224;195mbody_parses                 \u001b[39m\u001b[38;2;182;190;201mresponse body is valid JSON\u001b[39m\r\n  \u001b[38;2;126;224;195m✓\u001b[39m  \u001b[38;2;126;224;195mschema_valid                \u001b[39m\u001b[38;2;182;190;201mresponse matches the advertised resource shape\u001b[39m\r\n  \u001b[38;2;126;224;195m✓\u001b[39m  \u001b[38;2;126;224;195maccount_matches           "]
