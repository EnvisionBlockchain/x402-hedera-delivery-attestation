# Hedera x402 delivery attestation demo
#
# This file is a template; copy it to .env and fill it in. Never commit .env.
#
# Testnet is the default and is what every published result in this repo was
# produced on. Mainnet works, but only if you name it, and then every transfer
# below costs real HBAR.
#
# You need ONE funded testnet account, free from https://portal.hedera.com/
# `npm start` provisions the other three and fills in everything below it.
#
# PREFER THE ED25519 KEY. The portal offers both, and both settle x402 payments
# on Hedera; each has been run end to end here. ED25519 is worth preferring
# because a did:hedera root key must be Ed25519, so an ED25519 account carries
# one key for both its identity and its payments. With an ECDSA account the
# buyer needs a second, identity-only key, which `npm start` generates and
# writes to BUYER_DID_PRIVATE_KEY. An ED25519 DER key starts 302e020100300506032b6570...
#
# You can skip this file entirely:
#   HEDERA_ACCOUNT_ID=0.0.xxxxx HEDERA_PRIVATE_KEY=302e... npm start

# testnet or mainnet. Nothing else is accepted: a typo here is refused rather
# than defaulted, so it can never quietly pick a network for you.
#
# On mainnet the facilitator default switches to one that can actually settle
# there, and MAX_SPEND_HBAR below defaults ten times tighter.
HEDERA_NETWORK=testnet

# --- The four parties -------------------------------------------------------
# The three accounts provisioned for you are ED25519, and each one's account key
# is also its did:hedera root key. That is what makes "who got paid" and "who is
# identified" the same key, checkable against the ledger rather than asserted in
# a document. The buyer is whatever the portal gave you; if that is an ECDSA
# account, its identity key is separate and is written below.

# Pays for the resource, and funds provisioning. The only value you must supply.
# HEDERA_ACCOUNT_ID / HEDERA_PRIVATE_KEY work as aliases for these.
BUYER_ACCOUNT_ID=
BUYER_PRIVATE_KEY=

# Provisioned for you. Sells the resource and actually delivers it.
SELLER_ACCOUNT_ID=
SELLER_PRIVATE_KEY=

# Sells the resource, takes payment, and returns fabricated values.
# This is a deliberate mock. It exists to be caught.
MOCK_SELLER_ACCOUNT_ID=
MOCK_SELLER_PRIVATE_KEY=

# Independently checks delivery and signs the attestation.
VERIFIER_ACCOUNT_ID=
VERIFIER_PRIVATE_KEY=

# --- Facilitator ------------------------------------------------------------
# Co-signs as fee payer and submits the transfer. Open access, no API key.
# If it is unavailable, point this at any x402 facilitator that settles on your
# network; blocky402 is self-hostable, see https://blocky402.com/docs/
# Leave this unset. The default follows HEDERA_NETWORK, which is what you want:
# api.testnet.blocky402.com on testnet, api.blocky402.com on mainnet. Setting it
# here pins one facilitator across both networks, and a facilitator that cannot
# settle on your network is refused at startup rather than mid-payment.
# FACILITATOR_URL=

# --- Demo tuning ------------------------------------------------------------
# Price of one call, in HBAR. Converted to atomic units only at the x402
# boundary, because the protocol requires an integer amount on the wire.
PRICE_HBAR=0.01

# The buyer refuses to sign anything above this, in HBAR. A spending agent
# needs a cap. Leave unset to get 0.1 on testnet and 0.01 on mainnet; setting it
# here applies the same cap to both.
# MAX_SPEND_HBAR=0.1

# The account whose state the seller sells a snapshot of. Deliberately an
# account this demo never transacts against, so the verifier's independent
# re-query returns the same values the seller saw.
SNAPSHOT_ACCOUNT_ID=0.0.2

# Local ports. Only worth setting if something else already holds one; a
# collision now fails with a message naming the port rather than a raw stack.
HONEST_SELLER_PORT=4021
DISHONEST_SELLER_PORT=4022
SMOKE_PORT=4020

# --- Written automatically by `npm start` ---------------------------------
# Leave all of these blank. They are provisioned and written for you.

ATTESTATION_TOPIC_ID=
BUYER_DID=
SELLER_DID=
MOCK_SELLER_DID=
VERIFIER_DID=

# Written only when the buyer's account is ECDSA, which cannot be a did:hedera
# root key. It identifies the buyer; it controls no funds.
# BUYER_DID_PRIVATE_KEY=
